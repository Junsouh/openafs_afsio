# Build rules for the OpenAFS aclutil test suite.

srcdir=@srcdir@
abs_top_builddir=@abs_top_builddir@
include @TOP_OBJDIR@/src/config/Makefile.config
include @TOP_OBJDIR@/src/config/Makefile.pthread

MODULE_CFLAGS = -I$(TOP_OBJDIR) -I$(srcdir)/../common/

LIBS = $(abs_top_builddir)/tests/common/libafstest_common.la \
       $(abs_top_builddir)/src/cmd/liboafs_cmd.la \
       $(abs_top_builddir)/src/ptserver/liboafs_prot.la \
       $(abs_top_builddir)/src/comerr/liboafs_comerr.la \
       $(abs_top_builddir)/src/opr/liboafs_opr.la \
       $(abs_top_builddir)/src/libacl/liboafs_acl.la \

BINS = aclutil-t

all: $(BINS)

aclutil-t: aclutil-t.o $(LIBS)
	$(LT_LDRULE_static) aclutil-t.o \
		$(LIBS) $(LIB_roken) $(XLIBS)

install:

clean distclean:
	$(LT_CLEAN)
	$(RM) -f $(BINS) *.o core